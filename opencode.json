{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-bridge": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Browser AI Bridge",
      "options": {
        "baseURL": "http://127.0.0.1:8789/v1",
        "apiKey": "local"
      },
      "models": {
        "gemini-browser": {
          "name": "Gemini Browser",
          "tool_call": true
        },
        "deepseek-browser": {
          "name": "DeepSeek Browser",
          "tool_call": true
        },
        "z-ai-browser": {
          "name": "Z.ai Browser",
          "tool_call": true
        }
      }
    }
  },
  "model": "local-bridge/z-ai-browser"
}